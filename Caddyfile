vpn.bablo.bot {
    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server header
        -Server
    }

    # Our custom API routes go to vpn-ui
    handle /api/auth {
        reverse_proxy vpn-ui:3000
    }
    handle /api/config {
        reverse_proxy vpn-ui:3000
    }
    handle /api/vless/* {
        reverse_proxy vpn-ui:3000
    }
    handle /api/vless-url {
        reverse_proxy vpn-ui:3000
    }
    handle /api/singbox/* {
        reverse_proxy vpn-ui:3000
    }
    handle /api/xray/* {
        reverse_proxy vpn-ui:3000
    }

    # WireGuard API requests go to wg-easy
    handle /api/* {
        reverse_proxy wg-easy:51821
    }

    # Everything else goes to our custom UI
    handle {
        reverse_proxy vpn-ui:3000
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
