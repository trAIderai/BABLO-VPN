# BABLO VPN Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Your server's public IP or domain
WG_HOST=vpn.example.com

# Bcrypt password hash (generate with: docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YOUR_PASSWORD')
# IMPORTANT: Escape each $ as $$ for docker-compose
# Example: $2a$12$xxx becomes $$2a$$12$$xxx
PASSWORD_HASH=$$2a$$12$$your_hash_here

# ============================================
# OPTIONAL: Cloudflare Turnstile CAPTCHA
# ============================================
# Get your keys at: https://dash.cloudflare.com/turnstile
# If not set, CAPTCHA will be disabled (app works without it)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ============================================
# VLESS Reality Configuration (for advanced protection)
# ============================================
# These values are extracted from 3x-ui panel after creating an inbound
# Access 3x-ui at https://your-server:2053 (default login: admin/admin)
#
# 1. Create new inbound: VLESS + Reality + TCP
# 2. Copy these values from the inbound settings:
#
# VLESS_UUID - Client UUID from the inbound
# VLESS_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# REALITY_PUBLIC_KEY - From Reality settings (not private key!)
# REALITY_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# REALITY_SHORT_ID - One of the short IDs from Reality settings
# REALITY_SHORT_ID=xxxxxxxxxxxxxx
#
# VLESS_PORT - Port of the VLESS inbound (default 8443)
# VLESS_PORT=8443

# Trojan password (from 3x-ui Trojan inbound)
# TROJAN_PASSWORD=your-trojan-password
# TROJAN_PORT=8444

# Hysteria2 password (from 3x-ui Hysteria2 inbound)
# HYSTERIA2_PASSWORD=your-hysteria2-password
# HYSTERIA2_PORT=8445
