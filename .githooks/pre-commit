#!/usr/bin/env bash
#
# Отклоняет коммит, если в добавляемых строках есть похожее на секрет.
#
# Репозиторий публичный, и все прошлые утечки попали в него одинаково: боевое
# значение писали прямо в отслеживаемый файл. Хук проверяет ТОЛЬКО добавляемые
# строки (+) в индексе — существующая история его не волнует.
#
# Установка: git config core.hooksPath .githooks
# Обойти осознанно: git commit --no-verify
#
set -uo pipefail

# Сам себя не проверяем: внутри лежат шаблоны, а не значения.
DIFF=$(git diff --cached --unified=0 -- . ':(exclude).githooks/*' | grep '^+' | grep -v '^+++')
[ -z "$DIFF" ] && exit 0

FOUND=0
check() {
    local name="$1" pattern="$2" allow="${3:-}"
    local hits
    hits=$(printf '%s\n' "$DIFF" | grep -nE "$pattern" || true)
    [ -n "$allow" ] && hits=$(printf '%s\n' "$hits" | grep -vE "$allow" || true)
    if [ -n "$hits" ]; then
        echo "  ✗ $name:"
        printf '%s\n' "$hits" | head -3 | cut -c1-100 | sed 's/^/      /'
        FOUND=1
    fi
}

check "bcrypt-хэш"        '\$2[aby]\$[0-9]{2}\$[A-Za-z0-9./]{53}'
check "приватный ключ"    'BEGIN [A-Z ]*PRIVATE KEY'
check "ключ WireGuard/PSK" '(PrivateKey|PresharedKey|privateKey|preSharedKey)[^A-Za-z0-9]{1,4}[A-Za-z0-9+/]{43}='
check "UUID"              '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
check "пароль значением"  '(PASSWORD|PASSWD|ADMIN_PASSWORD|SECRET_KEY|API_KEY)=[A-Za-z0-9]' 'your_|example|xxx|REDACTED|\$\{'
check "пароль в тексте"   '(Пароль|Password|пароль):[[:space:]]+[A-Za-z0-9._-]{6,}' 'REDACTED|<|\$\{'
check "ключ Turnstile"    '0x4AAAAAA'

if [ "$FOUND" = "1" ]; then
    cat <<'MSG'

КОММИТ ОТКЛОНЁН: в добавляемых строках похоже на секрет.

Репозиторий публичный — удаление из рабочего дерева НЕ убирает значение из
истории, а сама утечка остаётся действующей до ротации.

Что делать:
  • вынести значение в файл под .gitignore (.env, adguard/AdGuardHome.yaml,
    ru-server/pbx.env), а в репозитории оставить только образец с заглушкой;
  • если это заведомо не секрет — git commit --no-verify

MSG
    exit 1
fi
exit 0
