# Реквизиты SIP-провайдера для sip-probe.py.
# Скопировать в pbx.env (он в .gitignore — репозиторий публичный, в git это класть нельзя).
#
# Где взять: CloudSoftphone -> Настройки -> аккаунт -> SIP server / username.
# Либо снять с туннеля на VPN-сервере:
#   PID=$(docker inspect -f '{{.State.Pid}}' wg-easy)
#   nsenter -t $PID -n tcpdump -i wg0 -n -s0 -A 'port 5060' -c 10

PBX_HOST=<tenant>.pbx.<provider>.io
SIP_USER=<sip-username>
